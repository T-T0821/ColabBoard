# cp terraform.tfvars.example terraform.tfvars して書き換える。

project_id = "my-gcp-project"

# 独自ドメインを使うとき(A レコードを出力の ip_address に向ける)。空なら <ip>.sslip.io。
# domain     = "board.example.com"
# acme_email = "admin@example.com"

# region       = "asia-northeast1"
# zone         = "asia-northeast1-b"
# machine_type = "e2-medium"

# アクセス元を絞るとき(既定は制限なし)。社内の固定 IP や VPN の出口などを CIDR で並べる。
# allowed_source_ranges = ["203.0.113.0/24", "198.51.100.10/32"]

# サーバーの環境変数(docs/self-hosting.md の一覧)。COOKIE_SECURE / TRUST_PROXY / PUBLIC_URL は自動で入る。
env = {
  RUST_LOG         = "info"
  ANONYMOUS_BOARDS = "0" # 知らない人に使わせないなら
  # MAX_USERS      = "50"
  # ADMIN_LOGINS   = "alice"
}

# 秘密の値は Secret Manager に(値は gcloud secrets versions add で入れる)。
secret_env_names = ["ANTHROPIC_API_KEY"]
# secret_env_names = ["ANTHROPIC_API_KEY", "OIDC_CLIENT_SECRET"]

# サーバーの定期バックアップを GCS にも置く(README の「GCS へのバックアップ」で HMAC キーを入れる)。
# gcs_backup = true

# alert_email = "admin@example.com"
